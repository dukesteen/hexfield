{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hexfield",
  "main": "worker/worker.ts",
  "account_id": "3cccf30c3a4ca0900c908210c523166c",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hexfield.steenbakkers.cc", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/room/*", "/api/*", "/healthz"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CloudflareRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CloudflareRoom"] }],
  "ratelimits": [
    { "name": "CONNECTION_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  "vars": { "APP_ORIGIN": "https://hexfield.steenbakkers.cc" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
