{
  "name": "hexfield",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cp2p/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @cp2p/web routes:generate && tsc -b && pnpm typecheck:tests && pnpm typecheck:engine",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:engine": "node tools/check-engine-types.mjs",
    "lint": "oxlint --type-aware --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @cp2p/web test:e2e",
    "deps:check": "depcruise --config .dependency-cruiser.cjs apps packages tools && node tools/check-boundaries.mjs",
    "purity:check": "node tools/check-engine-purity.mjs",
    "i18n:check": "node tools/check-i18n-keys.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm deps:check && pnpm purity:check && pnpm i18n:check && pnpm test",
    "ci": "pnpm check && pnpm build && pnpm test:coverage && pnpm test:e2e",
    "sim": "tsc -b tools/sim && node tools/sim/dist/index.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3",
    "dependency-cruiser": "^18.4.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "svgo": "^4.1.0",
    "typescript": "^5.9",
    "vite": "^8.3.1",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.7.1"
}
