{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "customConditions": ["@cp2p/source"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.ts",
    "packages/*/tests/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/tests/**/*.ts",
    "apps/*/tests/**/*.tsx",
    "tools/*/src/**/*.ts",
    "tools/*/src/**/*.tsx",
    "tools/*/tests/**/*.ts",
    "tools/*/tests/**/*.tsx",
    "apps/*/*.config.ts",
    "vitest.config.ts",
    "vitest.workspace.ts"
  ]
}
